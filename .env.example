OLLAMA_MODEL=gpt-oss:120b
# gpt-oss:120b
# qwen3:8b
OLLAMA_MODEL_ROUTER=gpt-oss:120b
# Sua chave do Ollama Cloud, sem aspas e sem espaço. Este arquivo é só o modelo: a chave vai no .env.
OLLAMA_API_KEY=sua_chave_de_api_aqui

# Sprint 4 (opcionais; os valores abaixo são os padrões)
# OLLAMA_EMBED_URL=http://localhost:11434
# OLLAMA_BASE_URL=https://ollama.com   (http://localhost:11434 para usar um modelo baixado no computador)
# OLLAMA_NUM_PREDICT=1024
# RAG_COLECAO=chargegrid_kb
# RAG_PROMPT_VERSAO=v2
# RAG_BUSCA=intercalada   (vetorial, hibrida ou intercalada)
# RAG_K=4
# RAG_LIMIAR=0.68
